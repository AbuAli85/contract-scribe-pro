# Supabase (required)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Drive file picker (client ID only — never commit the secret)
VITE_GOOGLE_DRIVE_CLIENT_ID=

# AI template scanning (Anthropic Claude)
VITE_ANTHROPIC_API_KEY=

# SmartPro Hub integration
# No client API key. Parties data is fetched through the smartpro-parties edge
# function, which mints a Hub JWT server-side. Set these as SUPABASE FUNCTION
# secrets (never VITE_*, which are public): CONTRACT_SCRIBE_API_KEY, SMARTPRO_HUB_URL.
#   supabase secrets set CONTRACT_SCRIBE_API_KEY=… SMARTPRO_HUB_URL=https://<hub>
