# Supabase (required)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Drive file picker (client ID only — never commit the secret)
VITE_GOOGLE_DRIVE_CLIENT_ID=

# AI template scanning (Anthropic Claude)
VITE_ANTHROPIC_API_KEY=

# SmartPro Hub integration
# No API key required. The Hub authenticates the parties API with a short-lived
# JWT it mints and passes in the SSO launch URL (…&parties_token=<jwt>), which
# NewContract.tsx sends as a Bearer token. Do NOT reintroduce VITE_SMARTPRO_API_KEY:
# VITE_* vars are baked into the public client bundle, and the Hub no longer
# accepts a static key (it would only re-expose the signing secret).
