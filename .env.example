# Supabase (required)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Drive file picker (client ID only — never commit the secret)
VITE_GOOGLE_DRIVE_CLIENT_ID=

# AI template scanning (Anthropic Claude)
VITE_ANTHROPIC_API_KEY=

# Ministry letters free-tier gate (/letters)
# SERVER SIDE ONLY — set these as Supabase Edge Function secrets, never as
# VITE_* vars (anything VITE_* is compiled into the public JS bundle).
#   supabase secrets set LETTER_GATE_SALT=... RESEND_API_KEY=... LETTER_FROM_EMAIL=...
#
# LETTER_GATE_SALT   Long random string. Hashes OTP codes + IPs and signs the
#                    30-day gate token. Rotating it invalidates every issued
#                    token and every stored hash comparison.
# RESEND_API_KEY     Resend key used to deliver the verification codes.
# LETTER_FROM_EMAIL  From address, e.g. "SmartPRO <letters@thesmartpro.io>"
LETTER_GATE_SALT=
RESEND_API_KEY=
LETTER_FROM_EMAIL=

# SmartPro Hub integration
# DEPRECATED (security): VITE_SMARTPRO_API_KEY is no longer used. The parties
# API now authenticates with the short-lived SSO JWT captured at /auto-auth.
# Rotate CONTRACT_SCRIBE_API_KEY on the Hub — the old value shipped in public
# JS bundles and must be treated as compromised.
